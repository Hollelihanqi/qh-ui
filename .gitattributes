# Normalize line endings to LF on checkin, auto-convert on checkout per-OS
* text=auto eol=lf

# Force LF for source / config / docs
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.vue     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Force CRLF where required
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Treat as binary (no diff / no eol conversion)
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.svg     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.pdf     binary

# Lockfile: collapse diffs, mark generated
pnpm-lock.yaml -diff linguist-generated
